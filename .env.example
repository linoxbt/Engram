# Every variable Engram reads. Copy to .env.local for development; set the production ones in Netlify.
# Values below are safe placeholders: nothing here points a production build at localhost.

# ---- Appwrite (server) -------------------------------------------------------
# Leave APPWRITE_ENDPOINT empty to run on the local file-backed backend in development.
# In production (NODE_ENV=production) missing Appwrite settings are an error, not a silent
# fallback; set ENGRAM_BACKEND=local explicitly for a throwaway demo.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=engram
APPWRITE_CHECKPOINTS_BUCKET=checkpoints
# Legacy: exports are streamed and never stored; only set this if an older deployment wrote ex_* files to a separate bucket.
# APPWRITE_EXPORTS_BUCKET=exports
APPWRITE_VECTORSDB_SPEC=s-1vcpu-1gb
CHECKPOINT_FUNCTION_ID=checkpoint
LABELER_FUNCTION_ID=labeler
# Days of daily database backups that setup's backup policy keeps.
ENGRAM_BACKUP_RETENTION_DAYS=7

# ---- Appwrite (browser: Realtime) --------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_DB_ID=engram

# ---- Checkpoint signing (pnpm keygen) ----------------------------------------
# CP_PRIVATE_KEY belongs only in the checkpoint Function. Set it here only if
# this deployment signs inline (no Function) or for local development.
CP_KEY_ID=engram-cp-2026-10
CP_PRIVATE_KEY=
# The current public key (legacy single-key form) and its ID for the browser.
NEXT_PUBLIC_CP_PUBLIC_KEY=
NEXT_PUBLIC_CP_KEY_ID=engram-cp-2026-10
# Every public key ever used, "keyId:hex,keyId:hex", so checkpoints signed before a rotation still verify.
# CP_PUBLIC_KEYS is read by the server and Functions; NEXT_PUBLIC_CP_PUBLIC_KEYS is pinned into the browser at build time.
CP_PUBLIC_KEYS=
NEXT_PUBLIC_CP_PUBLIC_KEYS=
# Older name for the server's public key, used when NEXT_PUBLIC_CP_PUBLIC_KEY is unset.
# CP_PUBLIC_KEY=

# ---- Contradiction classifier, labeler, reflect ------------------------------
# provider:model. With no key, a deterministic rule-based classifier runs.
CLASSIFIER_MODEL=anthropic:claude-haiku-5-5
# Other models a space owner may pick in Settings (comma-separated). The operator pays for every call.
CLASSIFIER_MODELS=
# Used for Anthropic models (falls back to ANTHROPIC_API_KEY). OpenAI models read OPENAI_API_KEY and never receive an Anthropic key.
MODEL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required for Anthropic keys that are not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# ---- Public URLs and the demo space ------------------------------------------
# The site's public origin: email links, Function alerts and the MCP snippets use it. Must match an Appwrite Web platform.
NEXT_PUBLIC_APP_URL=https://your-engram.example.com
# Server-side fallback for the public origin when NEXT_PUBLIC_APP_URL is unset.
APP_URL=
# The demo space linked from the landing page, and the one guests may enter read-only (DEMO_SPACE wins on the server).
NEXT_PUBLIC_DEMO_SPACE=
DEMO_SPACE=

# ---- Optional ---------------------------------------------------------------
GITHUB_ANCHOR_TOKEN=
GITHUB_ANCHOR_REPO=you/engram-anchors
CRON_SECRET=
SEED_ADMIN_TOKEN=
# Email space owners when the sentinel finds tampering (needs an email provider in Appwrite Messaging).
ENGRAM_ALERT_EMAILS=false
ENGRAM_VECTOR_FILTERS=true
ENGRAM_EMBED_PREFIXES=true
# Sentinel Function: stop starting new spaces after this many ms, so a run fits the 300 s timeout.
SENTINEL_BUDGET_MS=240000

# --- Operations (optional) ---
# Public contact address shown on the Terms, Privacy and Cookie pages (falls back to GitHub issues).
NEXT_PUBLIC_CONTACT_EMAIL=
# Slack or Discord incoming-webhook URL that receives browser error reports.
ERROR_WEBHOOK_URL=

# ---- Provisioning from the Netlify build (production context only) -----------
# Set ENGRAM_PROVISION to a run id (16-64 chars of a-z0-9) to run scripts/provision.ts once; remove it afterwards.
ENGRAM_PROVISION=
# Comma-separated steps; default diagnose,setup,experiments,functions,seed. Optional: appwrite-live, quality, events; or all.
ENGRAM_PROVISION_STEPS=
ENGRAM_PROVISION_BUDGET_MIN=22
# X25519 public key from `pnpm decrypt-report --keygen <file>`. Without it no report file is written (logs only).
ENGRAM_REPORT_PUBKEY=
# Demo space seeded by provisioning: owner account, space name, and a run id that re-seeds it once.
ENGRAM_DEMO_OWNER=
ENGRAM_DEMO_NAME=Northwind support
ENGRAM_DEMO_RESET=
# Space checked by scripts/diagnose.ts (defaults to DEMO_SPACE / NEXT_PUBLIC_DEMO_SPACE).
ENGRAM_DIAGNOSE_SPACE=

# ---- Tests and tools ---------------------------------------------------------
# Live adapter suite (packages/server/test/appwrite-live.test.ts); skipped unless all three are set.
# APPWRITE_TEST_ENDPOINT=
# APPWRITE_TEST_PROJECT=
# APPWRITE_TEST_KEY=
# Reserved space key for test documents written to the real collections (never generated for real spaces).
# APPWRITE_TEST_SPACE=test0000
# MCP demo agent (pnpm demo-agent) and SDK examples.
# ENGRAM_URL=https://your-engram.example.com   # defaults to http://localhost:3000
# ENGRAM_KEY=eng_...
# ENGRAM_CP_PUBLIC_KEY=   # pins the checkpoint key in SDK examples

# ---- Local development ------------------------------------------------------
# ENGRAM_BACKEND=local
# ENGRAM_LOCAL_DIR=.engram-local
# Show email links (reset, verification) in API responses. Local backend only; never in production.
# ENGRAM_DEV_LINKS=true
