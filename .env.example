# ---- Appwrite (server) -------------------------------------------------------
# Leave APPWRITE_ENDPOINT empty to run on the local file-backed backend.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=engram
APPWRITE_CHECKPOINTS_BUCKET=checkpoints
APPWRITE_EXPORTS_BUCKET=exports
CHECKPOINT_FUNCTION_ID=checkpoint
LABELER_FUNCTION_ID=labeler

# ---- Appwrite (browser: Realtime) --------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_DB_ID=engram

# ---- Checkpoint signing (pnpm keygen) ----------------------------------------
# CP_PRIVATE_KEY belongs only in the checkpoint Function. Set it here only if
# this deployment signs inline (no Function) or for local development.
CP_KEY_ID=engram-cp-2026-10
CP_PRIVATE_KEY=
NEXT_PUBLIC_CP_PUBLIC_KEY=

# ---- Contradiction classifier, labeler, reflect ------------------------------
# provider:model. With no key, a deterministic rule-based classifier runs.
CLASSIFIER_MODEL=anthropic:claude-haiku-5-5
MODEL_API_KEY=

# ---- Optional ---------------------------------------------------------------
GITHUB_ANCHOR_TOKEN=
GITHUB_ANCHOR_REPO=you/engram-anchors
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_SPACE=
CRON_SECRET=
SEED_ADMIN_TOKEN=
ENGRAM_ALERT_EMAILS=false
ENGRAM_VECTOR_FILTERS=true
ENGRAM_EMBED_PREFIXES=true

# ---- Local development ------------------------------------------------------
# ENGRAM_BACKEND=local
# ENGRAM_LOCAL_DIR=.engram-local
