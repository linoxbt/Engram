{
  "name": "engram-sdk",
  "version": "1.0.0",
  "description": "TypeScript client for Engram: verifiable, time-travelling memory for AI agents.",
  "license": "BSD-2-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/sdk/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "dependencies": { "@noble/ed25519": "^3.2.0" },
  "devDependencies": { "@engram/core": "workspace:*" }
}
