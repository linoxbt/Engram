{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@engram/core": [
        "packages/core/src/index.ts"
      ],
      "@engram/server": [
        "packages/server/src/index.ts"
      ],
      "@engram/server/*": [
        "packages/server/src/*"
      ],
      "engram-sdk": [
        "packages/sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "functions/**/*.ts",
    "vitest.config.ts",
    "apps/web/e2e/**/*.ts",
    "apps/web/playwright.config.ts"
  ]
}
